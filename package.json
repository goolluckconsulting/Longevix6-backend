{
  "name": "longevix6-backend",
  "version": "1.0.0",
  "description": "Longevix6 E-Commerce & Clinical Consultation Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "db:init": "ts-node-dev src/db/initDb.ts"
  },
  "keywords": [
    "longevix6",
    "ecommerce",
    "razorpay",
    "postgresql",
    "express"
  ],
