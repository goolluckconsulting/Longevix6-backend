# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# PostgreSQL Database Configuration (Neon DB or Local)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Razorpay Credentials (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_clinic_email@gmail.com
SMTP_PASS=your_google_app_password
CLINIC_NOTIFICATION_EMAIL=drankitagupta83@gmail.com

# Admin Authentication (Minimum 64 characters random string for production)
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_long_for_security_123456789
ADMIN_DEFAULT_EMAIL=admin@longevix6.com
ADMIN_DEFAULT_PASSWORD=LongevixAdmin2026!Secure
ADMIN_DEFAULT_NAME="Clinic Administrator"

# AWS S3 Storage (Production Blog Images)
# If backend runs on AWS with an IAM Role/Profile, ACCESS_KEY and SECRET_KEY are NOT required
AWS_REGION=ap-south-1
AWS_S3_BUCKET=longevix6-blog-assets
AWS_ACCESS_KEY_ID=your_aws_access_key_if_not_using_iam_role
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_if_not_using_iam_role

# Meta WhatsApp & Instagram Chatbot Integration
META_VERIFY_TOKEN=your_meta_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_GRAPH_API_VERSION=v20.0
ENABLE_CHATBOT_MOCK=false
