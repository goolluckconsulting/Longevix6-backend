# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# PostgreSQL Database Configuration (Neon DB or Local)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Razorpay Credentials (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_clinic_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="Longevix6 Wellness Clinic <your_clinic_email@gmail.com>"
CLINIC_NOTIFICATION_EMAIL=drankitagupta83@gmail.com
